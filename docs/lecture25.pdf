         <pdfaType:prefix>pdfd</pdfaType:prefix>
         <pdfaType:description>A structure describing a single PDF Declaration asserting conformance with an externally-identified standard or profile.</pdfaType:description>
         <pdfaType:field>
          <rdf:Seq>
