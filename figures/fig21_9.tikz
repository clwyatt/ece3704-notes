\documentclass[tikz, border=10pt]{standalone}
\usepackage{pgfplots}
\pgfplotsset{compat=1.18}

\begin{document}
\begin{tikzpicture}
    \begin{axis}[
        axis lines=middle,
        xmin=-1.5, xmax=1.5,
        ymin=-1.5, ymax=1.5,
        xlabel={Re},
        ylabel={Im},
        grid=both,
        unit vector ratio=1 1, % Keep the circle circular
        title={Pole-Zero Plot},
        xtick={-1, 1},
        ytick={-1, 1},
    ]
        % Draw Unit Circle
        \draw[dashed, gray] (axis cs:0,0) circle [radius=1];

        % Plot Zeros (open circles)
        \addplot[only marks, mark=o, mark size=3pt, thick, blue] coordinates {
            (0, 0)
            (1, 0)
        };

        % Plot Poles (crosses)
        % Coordinates: 1/8 = 0.125, sqrt(7)/8 approx 0.3307
        \addplot[only marks, mark=x, mark size=4pt, thick, red] coordinates {
            (0.125, 0.3307)
            (0.125, -0.3307)
        };
        
    \end{axis}
\end{tikzpicture}
\end{document}